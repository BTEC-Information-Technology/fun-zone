{
  // Build:  npm run build:calculator
  // Deploy: npx wrangler deploy --config apps/calculator/wrangler.jsonc
  // The deploy creates the worker AND both custom domains (fun-zone.app + play-zone.app).
  "name": "calculator",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "calculator.fun-zone.app", "custom_domain": true },
    { "pattern": "calculator.play-zone.app", "custom_domain": true }
  ]
}
