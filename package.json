{
  "name": "fun-zone",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Small static games and utilities for fun-zone.app / play-zone.app, each deployed as its own Cloudflare Worker.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:portal && npm run build:2048 && npm run build:calculator && npm run build:memory && npm run build:nibbles && npm run build:shopping && npm run build:stopwatch && npm run build:sudoku && npm run build:textscan && npm run build:tictactoe && npm run build:units",
    "test": "npm run test:portal && npm run test:2048 && npm run test:calculator && npm run test:memory && npm run test:nibbles && npm run test:shopping && npm run test:stopwatch && npm run test:sudoku && npm run test:textscan && npm run test:tictactoe && npm run test:units",
    "dev:portal": "npm run dev --workspace portal",
    "build:portal": "npm run build --workspace portal",
    "test:portal": "npm run test --workspace portal",
    "dev:2048": "npm run dev --workspace apps/2048",
    "build:2048": "npm run build --workspace apps/2048",
    "test:2048": "npm run test --workspace apps/2048",
    "dev:calculator": "npm run dev --workspace calculator",
    "build:calculator": "npm run build --workspace calculator",
    "test:calculator": "npm run test --workspace calculator",
    "dev:memory": "npm run dev --workspace memory",
    "build:memory": "npm run build --workspace memory",
    "test:memory": "npm run test --workspace memory",
    "dev:nibbles": "npm run dev --workspace nibbles",
    "build:nibbles": "npm run build --workspace nibbles",
    "test:nibbles": "npm run test --workspace nibbles",
    "dev:shopping": "npm run dev --workspace shopping",
    "build:shopping": "npm run build --workspace shopping",
    "test:shopping": "npm run test --workspace shopping",
    "dev:stopwatch": "npm run dev --workspace stopwatch",
    "build:stopwatch": "npm run build --workspace stopwatch",
    "test:stopwatch": "npm run test --workspace stopwatch",
    "dev:sudoku": "npm run dev --workspace sudoku",
    "build:sudoku": "npm run build --workspace sudoku",
    "test:sudoku": "npm run test --workspace sudoku",
    "dev:textscan": "npm run dev --workspace textscan",
    "build:textscan": "npm run build --workspace textscan",
    "test:textscan": "npm run test --workspace textscan",
    "dev:tictactoe": "npm run dev --workspace tictactoe",
    "build:tictactoe": "npm run build --workspace tictactoe",
    "test:tictactoe": "npm run test --workspace tictactoe",
    "dev:units": "npm run dev --workspace units",
    "build:units": "npm run build --workspace units",
    "test:units": "npm run test --workspace units"
  }
}
